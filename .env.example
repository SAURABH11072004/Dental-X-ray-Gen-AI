# Copy to .env and edit. Never commit .env.
# Relative paths are resolved from the project root. Leave DATA_ROOT empty to auto-detect ./data or ./Data.
DATA_ROOT=
MODEL_CHECKPOINT_DIR=
# sqlite only. Leave empty for <project>/runtime/dentamind.sqlite3 (kept out of the image data folder).
# Must be on a local writable disk. Windows example: DATABASE_URL=sqlite:///C:/DentaMind/dentamind.sqlite3
DATABASE_URL=
LABEL_STUDIO_URL=http://localhost:8080
LABEL_STUDIO_API_KEY=
# Optional OpenAI-compatible endpoint for report drafting (only de-identified structured findings are sent).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
CUDA_VISIBLE_DEVICES=
FRONTEND_URL=http://localhost:5173
TENSORBOARD_URL=http://localhost:6006
MAX_UPLOAD_MB=25
# Automatically validate/manifest/split the main dataset when it appears in DATA_ROOT.
AUTO_PROCESS_DATASET=true
AUTO_PROCESS_INTERVAL_S=15
LOG_LEVEL=INFO
